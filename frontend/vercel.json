{
  "redirects": [
    {
      "source": "/",
      "destination": "/ua",
      "statusCode": 301
    },
    {
      "source": "/uk",
      "destination": "/ua",
      "statusCode": 301
    },
    {
      "source": "/uk/:path*",
      "destination": "/ua/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/frontend/**",
      "maxDuration": 30
    }
  }
}
